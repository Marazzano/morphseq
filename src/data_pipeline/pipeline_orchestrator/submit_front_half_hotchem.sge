#!/bin/bash
# Materialization-only run (front_half) for all 6 hotchem Keyence plates, AFTER the
# map_keyence_positions_to_wells tile-count fix. Produces stitched 3-tile full-field images.
# Submit from src/data_pipeline/pipeline_orchestrator:  qsub submit_front_half_hotchem.sge

#$ -N hotchem_front_half
#$ -cwd
#$ -q trapnell-long.q
#$ -l gpgpu=TRUE,cuda=1
#$ -l mfree=10G
#$ -pe serial 8
#$ -o hotchem_fronthalf.$JOB_ID.out
#$ -e hotchem_fronthalf.$JOB_ID.err

set -euo pipefail
trap 'status=$?; echo "=== hotchem_front_half FINISHED $(date) on $(hostname) - exit ${status} ==="; exit "${status}"' EXIT

CONDA_BASE="/net/trapnell/vol1/home/mdcolon/software/miniconda3"
CONDA_ENV="segmentation_grounded_sam"
SNAKEMAKE="${CONDA_BASE}/envs/${CONDA_ENV}/bin/snakemake"
SRC_ROOT="/net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/src"
CORES=8
FORCE_DISCOVERY="${FORCE_DISCOVERY:-0}"
FORCE_ARGS=()
if [[ "${FORCE_DISCOVERY}" == "1" ]]; then
  FORCE_ARGS=(--forcerun apply_position_to_well_mapping discover_wells)
fi

echo "=== hotchem front_half START $(date) on $(hostname) ==="
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
echo "FORCE_DISCOVERY=${FORCE_DISCOVERY}"
nvidia-smi -L || echo "WARNING: no GPU visible"

export PYTHONPATH="${SRC_ROOT}:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# front_half = ingest -> map/discover -> materialize products -> assemble/validate canonical
# per-well frame inventories. Give materialization GPU tokens so Snakemake can make progress
# through the image-materialization fan before any downstream model/QC stages are requested.
"${SNAKEMAKE}" front_half \
  --cores "${CORES}" \
  --resources gpu=6 \
  --set-resources materialize_image_product_for_well:gpu=1 \
  --keep-going \
  --rerun-triggers mtime \
  --printshellcmds \
  "${FORCE_ARGS[@]}" \
  --configfile config.yaml config_runtime_20260702_hotchem.yaml
