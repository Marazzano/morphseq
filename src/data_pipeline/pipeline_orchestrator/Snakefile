if not CONFIG_YAML.exists() or CONFIG_YAML.read_text(encoding="utf-8") != CONFIG_TEXT:
    CONFIG_YAML.write_text(CONFIG_TEXT, encoding="utf-8")

# Snakemake-facing path helpers — thin string-returning facade over paths.py.
# These close over DATA_ROOT so included .smk files get readable one-liners.
# Rule direction (input vs output) is decided by the rule block, not here.
def rule_artifact(step, artifact, experiment, *, path_mode, well_id=None, format_vars=None):
    return str(artifact_path(
        DATA_ROOT,
        step,
        artifact,
        experiment,
        path_mode=path_mode,
        well_id=well_id,
        format_vars=format_vars,
    ))

def rule_validated(step, artifact, experiment, *, path_mode, well_id=None, format_vars=None):
    return str(validated_path(
        DATA_ROOT,
        step,
        artifact,
        experiment,
        path_mode=path_mode,
        well_id=well_id,
        format_vars=format_vars,
    ))

def rule_step_dir(step, experiment, *, path_mode, well_id=None):
    return str(step_dir(DATA_ROOT, step, experiment, path_mode=path_mode, well_id=well_id))
