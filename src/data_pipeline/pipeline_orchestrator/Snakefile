        """
        {RUN} -m data_pipeline.feature_extraction.entrypoints.compute_curvature_metrics \
          --segmentation-tracking "{input.segmentation_tracking}" \
          --frame-contract "{input.frame_contract}" \
          --output-csv "{output.csv}"
        """

rule compute_pose_kinematics:
    input:
        segmentation_tracking = SEGMENTATION_DIR / "{experiment}" / "contracts" / "segmentation_tracking.csv",
        segmentation_tracking_done = SEGMENTATION_DIR / "{experiment}" / "contracts" / ".segmentation_tracking_merged.validated",
        frame_contract = EXPERIMENT_METADATA_DIR / "{experiment}" / "frame_contract.csv",
        frame_contract_done = EXPERIMENT_METADATA_DIR / "{experiment}" / ".frame_contract.validated",
    output:
        csv = FEATURES_DIR / "{experiment}" / "pose_kinematics" / "pose_kinematics_metrics.csv",
        done = FEATURES_DIR / "{experiment}" / "pose_kinematics" / "pose_kinematics_metrics.csv.validated",
    shell:
        """
        {RUN} -m data_pipeline.feature_extraction.entrypoints.compute_pose_kinematics \
          --segmentation-tracking "{input.segmentation_tracking}" \
          --frame-contract "{input.frame_contract}" \
          --output-csv "{output.csv}"
        """

rule compute_fraction_alive:
    input:
        segmentation_tracking = SEGMENTATION_DIR / "{experiment}" / "contracts" / "segmentation_tracking.csv",
        segmentation_tracking_done = SEGMENTATION_DIR / "{experiment}" / "contracts" / ".segmentation_tracking_merged.validated",
        frame_contract = EXPERIMENT_METADATA_DIR / "{experiment}" / "frame_contract.csv",
        frame_contract_done = EXPERIMENT_METADATA_DIR / "{experiment}" / ".frame_contract.validated",
        auxiliary_masks = AUXILIARY_MASKS_DIR / "{experiment}" / "contracts" / "auxiliary_masks.csv",
        auxiliary_masks_done = AUXILIARY_MASKS_DIR / "{experiment}" / "contracts" / ".auxiliary_masks.validated",
    output:
        csv = FEATURES_DIR / "{experiment}" / "fraction_alive" / "fraction_alive.csv",
        done = FEATURES_DIR / "{experiment}" / "fraction_alive" / "fraction_alive.csv.validated",
    shell:
