# Configuration — two kingdoms, two files (Scope 3 of the well-id throughline refactor):
#   config.yaml : the SCIENCE (what to run)      — committed, loaded as Snakemake `config`
#   env.yaml    : the ENVIRONMENT (where/how)    — GITIGNORED, loaded as a plain dict
# Both live beside this Snakefile. env.yaml is loaded separately (NOT merged into `config`) so
# that gitignoring machine paths stays clean. See:
#   docs/refactors/streamline-snakemake/well_id_throughline_refactor_plan.md (Scope 3)
configfile: str(Path(workflow.basedir) / "config.yaml")

WORKFLOW_DIR = Path(workflow.basedir)
# project_root is still DERIVED from the Snakefile location (zero per-machine setup needed);
# only the data/input/model ROOTS are made explicit/environment-driven below.
PROJECT_ROOT = WORKFLOW_DIR.parent.parent.parent

# --- Environment layer (env.yaml) -------------------------------------------------------------
_ENV_PATH = WORKFLOW_DIR / "env.yaml"
if not _ENV_PATH.exists():
    raise FileNotFoundError(
        f"Missing per-machine environment file: {_ENV_PATH}\n"
        f"Copy the template and edit it for this machine:\n"
        f"    cp {WORKFLOW_DIR / 'env.example.yaml'} {_ENV_PATH}"
    )
env = yaml.safe_load(_ENV_PATH.read_text())

# Interpreter: pinned by conda ENV NAME and resolved via `conda run -n` (portable; obeys the
# repo rule "never bare python / conda activate"). RUN is the ONE shell-prefix used by every
# rule: it activates the env and puts src/ on PYTHONPATH, then you append `-m <module> ...` or
# a script path. This replaces the per-rule `PYTHONPATH="..." "{PYTHON}"` boilerplate (Win 1).
CONDA_ENV = str(env["runtime"]["conda_env"])
CONDA_BASE = str(env["runtime"].get("conda_base", ""))
CONDA_BIN = f"{CONDA_BASE}/bin/conda" if CONDA_BASE else "conda"
DEVICE = str(env["runtime"].get("device", "cuda"))
SRC_ROOT = f"{PROJECT_ROOT}:{PROJECT_ROOT}/src"
RUN = (
    f"{CONDA_BIN} run -n {CONDA_ENV} --no-capture-output "
    f'env PYTHONPATH="{SRC_ROOT}" python'
)

# MODEL_RUN — the Python-3.9 interpreter for model steps whose pickles do not survive 3.10
# (the legacy VAE encode; see model_input_handoff_contract.md §9). Only FILES cross this line.
# Prefer a DIRECT executable path (no conda-run shell layer); fall back to `conda run -n <env>`.
# Either way PYTHONPATH carries src/ so the entrypoint module imports resolve.
_MODEL_PY_EXE = str(env["runtime"].get("model_python_executable", "") or "")
_MODEL_PY_ENV = str(env["runtime"].get("model_python_env", "") or "")
if _MODEL_PY_EXE:
    MODEL_RUN = f'env PYTHONPATH="{SRC_ROOT}" "{_MODEL_PY_EXE}"'
elif _MODEL_PY_ENV:
    MODEL_RUN = (
        f"{CONDA_BIN} run -n {_MODEL_PY_ENV} --no-capture-output "
        f'env PYTHONPATH="{SRC_ROOT}" python'
    )
else:
    MODEL_RUN = None  # no model interpreter configured; model rules fail loud when invoked

# Roots are first-class ABSOLUTE paths from env.yaml — data location is no longer welded to code
# location. The LAYOUT beneath each root stays in code (the pipeline path contract).
DATA_ROOT = Path(env["paths"]["output_root"])
INPUTS_DIR = Path(env["paths"]["input_root"])
MODELS_DIR = Path(env["paths"]["models_root"])

# Task entrypoints need the same config Snakemake used to build wildcards. Persist the merged
# runtime config (base config.yaml plus any --configfile overlays) and pass that to tasks instead of
# the base config file, otherwise a product overlay can plan BF__z_stack while the task re-loads the
# default projection-only config.
RUNTIME_CONFIG_DIR = DATA_ROOT / "_snakemake_runtime"
RUNTIME_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
