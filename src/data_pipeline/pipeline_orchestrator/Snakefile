# --- Front-end producer selection (mode-EXCLUSIVE) --------------------------------------------
# native = the microscope ingest/materialize producers; dropin = an external dataset's manifest.
# Both produce the SAME canonical artifacts (discovered_wells.txt, the per-well frame_inventory
# shards, the .validated sentinels), so EXACTLY ONE producer family is registered. The selector
# is the only thing that knows which; everything downstream of the gate is producer-agnostic.
# (Producer mode ends at the gate; canonical artifacts cross the gate; downstream sees the contract.)
FRONT_END_MODE = str(config.get("front_end", {}).get("mode", "native")).strip().lower()
if FRONT_END_MODE not in ("native", "dropin"):
    raise ValueError(
        f"config front_end.mode must be 'native' or 'dropin', got {FRONT_END_MODE!r}."
    )
# Drop-in ingress (config/CLI; NOT a PIPELINE_STEPS artifact). Required only in dropin mode.
_DROPIN_CONFIG = config.get("dropin", {})
DROPIN_MANIFEST_CSV = str(_DROPIN_CONFIG.get("frame_inventory_csv", ""))
DROPIN_IMAGE_ROOT = str(_DROPIN_CONFIG.get("image_root", ""))
if FRONT_END_MODE == "dropin" and not DROPIN_MANIFEST_CSV:
    raise ValueError(
        "front_end.mode='dropin' requires dropin.frame_inventory_csv (the ingress manifest path)."
    )


def _scope_token(microscope: str) -> str:
    return str(microscope).strip().lower()


FRONT_END_EXPERIMENT = "{experiment}"
SCOPE_TOKEN = _scope_token(MICROSCOPE)


def _configured_image_product_keys() -> tuple[str, ...]:
    requested_plan = load_image_materialization_plan(config)
    resolved_plan = resolve_materialization_plan(
        scope_name=SCOPE_TOKEN,
        requested_plan=requested_plan,
    )
    return tuple(image_product_key_for_resolved_product(p) for p in resolved_plan.products)


