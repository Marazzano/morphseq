def _configured_wells_for_experiment(experiment: str) -> list[str]:
    for config_key in ("target_wells", "experiment_wells"):
        configured = config.get(config_key) or {}
        wells = configured.get(str(experiment))
        if wells is None:
            wells = configured.get(experiment)
        if wells is None:
            for key, value in configured.items():
                if str(key) == str(experiment):
                    wells = value
                    break
        if wells is None:
            continue
        if isinstance(wells, str):
            return [wells]
        return [str(w) for w in wells]
    return []


def _selected_wells_csv(experiment: str) -> str:
    return ",".join(_configured_wells_for_experiment(experiment))

# ============================================================================
# Plate metadata (optional for build/segment/snips)
# ============================================================================


rule ingest_plate_metadata:
    """
    Normalize and validate plate layout metadata.

    Reads raw plate layout CSV/Excel, normalizes column names, adds
    experiment_id and well_id, then validates against schema.
    """
    input:
        plate_file = PLATE_METADATA_DIR / "{experiment}_well_metadata.xlsx"
    output:
        normalized_csv = PLATE_METADATA_CSV,
        validated = PLATE_METADATA_VALIDATED,
    params:
        experiment_id = "{experiment}"
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks ingest-plate-metadata \
          --input-file "{input.plate_file}" \
          --experiment "{params.experiment_id}" \
          --output-csv "{output.normalized_csv}" \
          --output-flag "{output.validated}"
        """



rule ingest_scope_metadata:
    """
    Extract scope metadata from the configured microscope's raw image files.

    Reads raw metadata to extract:
    - Micrometers per pixel (calibration)
    - Frame interval (timing)
    - Image dimensions
    - Channel information
    - Series/well mapping
    - Timestamps
    """
    input:
        raw_images_dir = RAW_IMAGES_DIR / MICROSCOPE / "{experiment}"
    output:
        # Both scopes emit the maximal acquisition inventory (record-only): YX1 from its one ND2 read,
        # Keyence from a raw-plane TIFF scan. The inventory is the never-collapsed system of record.
        **(
            {"scope_csv": SCOPE_METADATA_CSV, "acquisition_inventory_csv": SCOPE_ACQUISITION_INVENTORY_CSV}
            if MICROSCOPE in ("YX1", "Keyence")
            else {"scope_csv": SCOPE_METADATA_CSV}
        )
    params:
        experiment_id = "{experiment}",
        acquisition_inventory_arg = (
            lambda wc, output: f'--acquisition-inventory-csv "{output.acquisition_inventory_csv}"'
            if MICROSCOPE in ("YX1", "Keyence")
            else ""
        ),
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks ingest-scope-metadata \
          --raw-images-dir "{input.raw_images_dir}" \
          --experiment "{params.experiment_id}" \
          --microscope "{MICROSCOPE}" \
          --output-csv "{output.scope_csv}" \
          {params.acquisition_inventory_arg}
        """


rule map_positions_to_wells:
    """
    Physical positions-to-wells mapping (CSV→CSV) for the configured microscope.

    YX1: reads stage XY from scope_metadata CSV (no second ND2 open).
         Requires scope_metadata.yx1.ref_xy_csv in config.yaml.
    Keyence: near-passthrough (well already resolved at ingest).
    """
    input:
        scope_csv = SCOPE_METADATA_CSV,
    output:
        mapping_csv = POSITION_WELL_MAPPING_CSV,
        provenance_json = POSITION_WELL_MAPPING_PROVENANCE,
    params:
        experiment_id = "{experiment}",
        ref_xy_csv = str(YX1_REF_XY_CSV) if YX1_REF_XY_CSV else "",
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks map-positions-to-wells \
          --experiment "{params.experiment_id}" \
          --microscope "{MICROSCOPE}" \
          --scope-csv "{input.scope_csv}" \
          --ref-xy-csv "{params.ref_xy_csv}" \
          --output-mapping-csv "{output.mapping_csv}" \
          --output-provenance-json "{output.provenance_json}"
        """


rule apply_position_to_well_mapping:
    """
    Apply position-to-well mapping to raw scope metadata to produce canonical well_index/well_id/image_id.
    """
    input:
        scope_csv = SCOPE_METADATA_CSV,
        mapping_csv = POSITION_WELL_MAPPING_CSV,
    output:
        mapped_csv = SCOPE_METADATA_MAPPED_CSV,
        validated = SCOPE_METADATA_MAPPED_VALIDATED,
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks apply-position-to-well-mapping \
          --experiment "{wildcards.experiment}" \
          --scope-csv "{input.scope_csv}" \
          --mapping-csv "{input.mapping_csv}" \
          --output-csv "{output.mapped_csv}" \
          --output-flag "{output.validated}"
        """

