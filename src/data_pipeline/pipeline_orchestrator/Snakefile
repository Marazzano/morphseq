# rules own discover_wells + the per-well frame_inventory shards (the user already has images, so no
# native discover/materialize runs). See rules/dropin_handoff.smk. Ingress (manifest + image_root) is
# config-supplied, NOT a registry artifact.
DROPIN_ENABLED = bool(config.get("dropin", {}).get("enabled", False))


def _scope_token(microscope: str) -> str:
    return str(microscope).strip().lower()


FRONT_END_EXPERIMENT = "{experiment}"
SCOPE_TOKEN = _scope_token(MICROSCOPE)
PLATE_METADATA_CSV = artifact_path(
    DATA_ROOT, "ingest_plate_metadata", "csv", FRONT_END_EXPERIMENT
