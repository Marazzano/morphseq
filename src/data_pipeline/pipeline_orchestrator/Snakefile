def _configured_wells_for_experiment(experiment: str) -> list[str]:
    for config_key in ("target_wells", "experiment_wells"):
        configured = config.get(config_key) or {}
        wells = configured.get(str(experiment))
        if wells is None:
            wells = configured.get(experiment)
        if wells is None:
            for key, value in configured.items():
                if str(key) == str(experiment):
                    wells = value
                    break
        if wells is None:
            continue
        if isinstance(wells, str):
            return [wells]
        return [str(w) for w in wells]
    return []


def _selected_wells_csv(experiment: str) -> str:
    return ",".join(_configured_wells_for_experiment(experiment))

