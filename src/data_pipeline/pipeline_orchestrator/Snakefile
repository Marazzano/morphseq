rule materialize_stitched_images:
    input:
        raw_images_dir = RAW_IMAGES_DIR / MICROSCOPE / "{experiment}",
        mapping_csv = POSITION_WELL_MAPPING_CSV,
        scope_csv = SCOPE_METADATA_MAPPED_CSV,
    output:
        stitched_index = EXPERIMENT_METADATA_DIR / "{experiment}" / "stitched_image_index.csv",
        done = BUILT_IMAGE_DATA_DIR / "{experiment}" / ".materialize_stitched_images.done"
    params:
        experiment_id = "{experiment}",
        selected_wells = lambda wc: _selected_wells_csv(wc.experiment),
        device = lambda wc: str(config.get("image_building", {}).get("device", "cuda")),
        overwrite = lambda wc: int(bool(config.get("image_building", {}).get("overwrite", False))),
        z_buffer = lambda wc: int(bool(config.get("image_building", {}).get("yx1", {}).get("z_buffer", False))),
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks materialize-stitched \
          --experiment "{params.experiment_id}" \
          --microscope "{MICROSCOPE}" \
          --raw-images-dir "{input.raw_images_dir}" \
          --scope-csv "{input.scope_csv}" \
          --mapping-csv "{input.mapping_csv}" \
          --output-root "{BUILT_IMAGE_DATA_DIR}" \
          --output-stitched-index-csv "{output.stitched_index}" \
          --selected-wells "{params.selected_wells}" \
          --output-image-extension "jpg" \
          --device-preference "{params.device}" \
          --overwrite "{params.overwrite}" \
          --done-flag "{output.done}"
        """


# Native discovery checkpoint — registered ONLY in native mode. In dropin mode the
# dropin_handoff.smk twin defines `discover_wells` writing the SAME DISCOVERED_WELLS_TXT, so exactly
# one checkpoint named `discover_wells` exists and `checkpoints.discover_wells.get(...)` resolves in
# both modes (the well-runner fan is producer-agnostic).
if FRONT_END_MODE == "native":
    checkpoint discover_wells:
        input:
            mapped_csv = SCOPE_METADATA_MAPPED_CSV,
            validated = SCOPE_METADATA_MAPPED_VALIDATED,
        output:
            wells = DISCOVERED_WELLS_TXT,
        shell:
            """
            {RUN} -m data_pipeline.pipeline_orchestrator.tasks discover-wells \
              --mapped-csv "{input.mapped_csv}" \
              --output-wells "{output.wells}"
            """

def wells_for_experiment(wildcards):
    checkpoints.discover_wells.get(experiment=wildcards.experiment)
    return run_well_ids_for_experiment(
        wildcards.experiment,
        config,
        output_root=DATA_ROOT,
    )


# ============================================================================
# Workflow Targets
#
# Tiered data-flow proof (depth → width → agnostic-seam, terminal = snip_qc):
#   docs/refactors/streamline-snakemake/target/specs/data_flow_test_plan.md
# `front_half` is the front-half finish line. The snip_qc rules are already wired
# (snip_qc.smk); `through_line` (below) is the named target that REQUESTS snip_qc
# end-to-end per discovered well — `rule all` deliberately stops at merged frame_masks.
# ============================================================================

def _front_half_targets(wc=None):
    # Step 6 finish line (Beat 1): the validated per-well frame_inventory shards emitted by the
    # live materialize_well branch. Making these a target is what takes the branch LIVE.
    targets = []
    for exp in EXPERIMENTS:
        for well_id in wells_for_experiment(_NS(experiment=exp)):
            targets.append(str(_materialize_well_validated(exp, well_id=well_id)))
    return targets


def _front_half_product_targets(wc=None):
    # Commit-4 product-grain target: resolved product plan -> product frame-inventory shard ->
    # product shard validation. Canonical per-well frame_inventory assembly is Commit 5.
    targets = []
    for exp in EXPERIMENTS:
        for well_id in wells_for_experiment(_NS(experiment=exp)):
            for product_key in IMAGE_PRODUCT_KEYS:
                targets.append(str(_frame_inventory_product_validated(
                    exp, well_id=well_id, product_key=product_key
                )))
    return targets


def _through_line_targets(wc=None):
    # Data-flow through-line terminal (data_flow_test_plan.md): the experiment-level MERGED snip_qc
    # verdict for every experiment. snip_qc is the terminal of the depth/width proof (everything
    # past it — embeddings, analysis_ready — is out of scope). Requesting the MERGED artifact drives
    # the WHOLE spine raw -> snip_qc per well AND the merge seam: merge_snip_qc depends on every
    # per-well snip_qc shard + its `.validated` sentinel (rules/snip_qc.smk), so naming the merged
    # output transitively requires the entire per-well fan — materialize_well -> frame_inventory ->
    # frame_detections -> frame_masks -> physical_embryo_registry -> snip processing/aux masks ->
    # {mask_geometry, pose_kinematics, fraction_alive, stage_predictions, curvature_metrics} ->
    # {surface_area, mask_quality, death} -> snip_qc -> merge_snip_qc.
    # (The QC products read the per-product feature shards directly; there is no consolidation hop.)
    #   - Tier 1 (DEPTH): config pins ONE well -> merge is a degenerate 1-shard stack (still exercises
    #     the merge rule end-to-end on a single well).
    #   - Tier 2 (WIDTH): no well filter -> merge fans over all discovered wells AND exercises the
    #     "merge never shrinks" seam the per-well-only target could not.
    # _snipqc_artifact lives in rules/snip_qc.smk (included above), so it is in scope here.
    targets = []
    for exp in EXPERIMENTS:
        targets.append(str(_snipqc_artifact(exp, path_mode=PATH_MODE_MERGED)))
    return targets


def _reports_targets(wc=None):
    # Every registered `*_report` step's artifacts, for every experiment. Reports are DAG LEAVES
    # (nothing consumes them; see viz/report_world.md § DAG Wiring) — but being a leaf is about
    # graph shape, not about who REQUESTS the leaf. The `reports` target requests all of them;
    # `rule all` additionally requests the stage rollups (below) so a default run also refreshes
    # the review pages. A failing report never corrupts upstream data — it is the end of the line.
    report_steps = [step for step in PIPELINE_STEPS if step.endswith("_report")]
    targets = []
    for exp in EXPERIMENTS:
        for step in report_steps:
            for artifact in PIPELINE_STEPS[step]["artifacts"]:
                targets.append(rule_artifact(step, artifact, exp, path_mode=PATH_MODE_EXPERIMENT))
    return targets


def _stage_rollup_report_targets(wc=None):
    # Just the 3 stage rollup pages, for every experiment. Requesting a rollup transitively pulls
    # its stage's per-step reports (the rollup rule lists them as inputs), so this one list drags
    # the whole report tier in without enumerating every per-step artifact. Used by `rule all`.
    targets = []
    for exp in EXPERIMENTS:
        for step in PIPELINE_STEPS:
            if step.endswith("_rollup_report"):
                for artifact in PIPELINE_STEPS[step]["artifacts"]:
                    targets.append(rule_artifact(step, artifact, exp, path_mode=PATH_MODE_EXPERIMENT))
    return targets


class _NS:
    # tiny wildcards stand-in so wells_for_experiment (which reads wildcards.experiment) can be
    # called outside a rule context for the front_half aggregate target.
    def __init__(self, experiment):
        self.experiment = experiment


rule front_half:
    """Step 6 finish line — build the live per-well frame_inventory shards through validation.

    Runs ingest → map → join → discover → materialize_well[well_id] →
    validate_frame_inventory_for_well for every discovered well. Does NOT drive segmentation /
    features (that is Beat 2). This is the explicit Beat-1 target; `rule all` is untouched.
    """
    input:
        _front_half_targets


rule front_half_products:
    """Product-grain materialization target; stops before canonical frame_inventory assembly."""
    input:
        _front_half_product_targets


rule through_line:
    """Data-flow through-line target — raw ND2 -> the per-snip snip_qc verdict, end-to-end.

    The named REQUEST for snip_qc (the snip_qc rules are already wired in snip_qc.smk; nothing
    asked for them — `rule all` deliberately stops at merged frame_masks). Mirrors `front_half`:
    aggregates the validated per-well snip_qc shards for every discovered well, so the requested
    well-set is decided by config (`target_wells`), not by this rule.

    Requests the experiment-level MERGED snip_qc, which transitively pulls every per-well shard
    AND the merge_snip_qc rule, so the merge seam is exercised too.

      - Tier 1 (DEPTH): overlay a one-well config (config_smoke_through_line_20250912_B01.yaml) ->
        this builds ONE well raw -> snip_qc (merge is a degenerate 1-shard stack). CPU.
      - Tier 2 (WIDTH): no well filter -> this builds all discovered wells and merges them. GPU
        (after the GPU gate).

    See: docs/refactors/streamline-snakemake/target/specs/data_flow_test_plan.md
    """
    input:
        _through_line_targets


rule reports:
    """TERMINAL aggregate target — every registered `*_report` step's artifacts, for every
    experiment. Never part of `rule all` or any other rule's input: a report is a DAG leaf
    (viz/report_world.md); this is the only rule that requests one. Run explicitly:
    `snakemake reports`, or request a single report by its step name, e.g.
    `snakemake death_detection_report`.
    """
    input:
        _reports_targets


rule all:
    default_target: True
    """Default target: build through merged frame_masks for all experiments, plus the stage
    rollup review pages. The rollups are DAG leaves (they gate nothing), so if one fails the
    core data products are already built and the graph is preserved; run with --keep-going to
    let the rest finish. To build the pipeline WITHOUT reports, request the data target directly."""
    input:
        expand(
            str(_frame_masks_artifact("{exp}", "frame_masks", path_mode=PATH_MODE_MERGED)),
            exp=EXPERIMENTS
        ),
        _stage_rollup_report_targets,
