"""
MorphSeq Pipeline - Snakemake Workflow

Contract-driven pipeline:
  - Extract physical scope metadata (scope-specific)
  - Build stitched FF images (scope-specific)
  - Build a single physical frame contract (source of truth)
  - Segment+track per well from the frame contract (GDINO + SAM2)
  - Process snips per well from segmentation_tracking only
"""

from pathlib import Path
import os
import json
import yaml

from data_pipeline.pipeline_orchestrator.orchestration import (
    artifact_path,
    provenance_path,
    run_well_ids_for_experiment,
    validated_path,
)

# Configuration — two kingdoms, two files (Scope 3 of the well-id throughline refactor):
#   config.yaml : the SCIENCE (what to run)      — committed, loaded as Snakemake `config`
#   env.yaml    : the ENVIRONMENT (where/how)    — GITIGNORED, loaded as a plain dict
# Both live beside this Snakefile. env.yaml is loaded separately (NOT merged into `config`) so
# that gitignoring machine paths stays clean. See:
#   docs/refactors/streamline-snakemake/well_id_throughline_refactor_plan.md (Scope 3)
configfile: str(Path(workflow.basedir) / "config.yaml")

WORKFLOW_DIR = Path(workflow.basedir)
# project_root is still DERIVED from the Snakefile location (zero per-machine setup needed);
# only the data/input/model ROOTS are made explicit/environment-driven below.
PROJECT_ROOT = WORKFLOW_DIR.parent.parent.parent

# --- Environment layer (env.yaml) -------------------------------------------------------------
_ENV_PATH = WORKFLOW_DIR / "env.yaml"
if not _ENV_PATH.exists():
    raise FileNotFoundError(
        f"Missing per-machine environment file: {_ENV_PATH}\n"
        f"Copy the template and edit it for this machine:\n"
        f"    cp {WORKFLOW_DIR / 'env.example.yaml'} {_ENV_PATH}"
    )
env = yaml.safe_load(_ENV_PATH.read_text())

# Interpreter: pinned by conda ENV NAME and resolved via `conda run -n` (portable; obeys the
# repo rule "never bare python / conda activate"). RUN is the ONE shell-prefix used by every
# rule: it activates the env and puts src/ on PYTHONPATH, then you append `-m <module> ...` or
# a script path. This replaces the per-rule `PYTHONPATH="..." "{PYTHON}"` boilerplate (Win 1).
CONDA_ENV = str(env["runtime"]["conda_env"])
CONDA_BASE = str(env["runtime"].get("conda_base", ""))
CONDA_BIN = f"{CONDA_BASE}/bin/conda" if CONDA_BASE else "conda"
DEVICE = str(env["runtime"].get("device", "cuda"))
SRC_ROOT = f"{PROJECT_ROOT}:{PROJECT_ROOT}/src"
RUN = (
    f"{CONDA_BIN} run -n {CONDA_ENV} --no-capture-output "
    f'env PYTHONPATH="{SRC_ROOT}" python'
)

# Roots are first-class ABSOLUTE paths from env.yaml — data location is no longer welded to code
# location. The LAYOUT beneath each root stays in code (the pipeline path contract).
DATA_ROOT = Path(env["paths"]["output_root"])
INPUTS_DIR = Path(env["paths"]["input_root"])
MODELS_DIR = Path(env["paths"]["models_root"])
PLATE_METADATA_DIR = INPUTS_DIR / "plate_metadata"
RAW_IMAGES_DIR = INPUTS_DIR / "raw_image_data"

# Output directories (layout beneath output_root — code contract, not environment)
EXPERIMENT_METADATA_DIR = DATA_ROOT / "experiment_metadata"
BUILT_IMAGE_DATA_DIR = DATA_ROOT / "built_image_data"
SEGMENTATION_DIR = DATA_ROOT / "segmentation_and_tracking"
PROCESSED_SNIPS_DIR = DATA_ROOT / "processed_snips"
AUXILIARY_MASKS_DIR = DATA_ROOT / "auxiliary_masks"
FEATURES_DIR = DATA_ROOT / "computed_features"
QUALITY_CONTROL_DIR = DATA_ROOT / "quality_control"
ANALYSIS_READY_DIR = DATA_ROOT / "analysis_ready"

# Experiment identifiers
EXPERIMENTS = config.get("experiments", ["20250912"])
MICROSCOPE = str(config.get("microscope", "YX1"))


def _scope_token(microscope: str) -> str:
    return str(microscope).strip().lower()


FRONT_END_EXPERIMENT = "{experiment}"
SCOPE_TOKEN = _scope_token(MICROSCOPE)
PLATE_METADATA_CSV = artifact_path(
    DATA_ROOT, "ingest_plate_metadata", "csv", FRONT_END_EXPERIMENT
)
SCOPE_METADATA_CSV = artifact_path(
    DATA_ROOT,
    "ingest_scope_metadata",
    "raw",
    FRONT_END_EXPERIMENT,
    format_vars={"scope": SCOPE_TOKEN},
)
SCOPE_ACQUISITION_INVENTORY_CSV = artifact_path(
    DATA_ROOT,
    "ingest_scope_metadata",
    "acquisition_inventory",
    FRONT_END_EXPERIMENT,
    format_vars={"scope": SCOPE_TOKEN},
)
POSITION_WELL_MAPPING_CSV = artifact_path(
    DATA_ROOT, "map_positions_to_wells", "mapping", FRONT_END_EXPERIMENT
)
POSITION_WELL_MAPPING_PROVENANCE = provenance_path(
    DATA_ROOT, "map_positions_to_wells", "mapping", FRONT_END_EXPERIMENT
)
SCOPE_METADATA_MAPPED_CSV = artifact_path(
    DATA_ROOT,
    "apply_position_to_well_mapping",
    "mapped",
    FRONT_END_EXPERIMENT,
)
SCOPE_METADATA_MAPPED_VALIDATED = validated_path(
    DATA_ROOT,
    "apply_position_to_well_mapping",
    "mapped",
    FRONT_END_EXPERIMENT,
)
DISCOVERED_WELLS_TXT = artifact_path(
    DATA_ROOT, "discover_wells", "wells", FRONT_END_EXPERIMENT
)

# YX1 reference plate XY grid (config-sourced; required for CSV→CSV series mapping).
# Set scope_metadata.yx1.ref_xy_csv in config.yaml to a real path before running YX1.
_YX1_REF_XY_CSV = config.get("scope_metadata", {}).get("yx1", {}).get("ref_xy_csv", "")
YX1_REF_XY_CSV = Path(_YX1_REF_XY_CSV) if _YX1_REF_XY_CSV else None

print(f"Project root: {PROJECT_ROOT}")
print(f"Output root:  {DATA_ROOT}")
print(f"Inputs root:  {INPUTS_DIR}")
print(f"Models root:  {MODELS_DIR}")
print(f"Conda env:    {CONDA_ENV}")
print(f"Experiments:  {EXPERIMENTS}")
print(f"Microscope:   {MICROSCOPE}")

# Wildcard and identifier contract source:
# docs/refactors/streamline-snakemake/identifier_and_wildcard_contract.md
# Snakemake wildcards only capture path pieces; semantic validation stays in
# Python helpers and input functions.
# Smoke subsets (for example 20240418 -> A01,C01) come from config, not code.
ruleorder: generate_auxiliary_masks_well > aggregate_auxiliary_masks
ruleorder: segment_and_track_per_well > merge_segmentation_tracking
ruleorder: run_snip_processing_per_well > merge_snip_manifests

include: str(WORKFLOW_DIR / "rules" / "frame_inventory.smk")
include: str(WORKFLOW_DIR / "rules" / "quality_control.smk")

def _configured_wells_for_experiment(experiment: str) -> list[str]:
    for config_key in ("target_wells", "experiment_wells"):
        configured = config.get(config_key) or {}
        wells = configured.get(str(experiment))
        if wells is None:
            wells = configured.get(experiment)
        if wells is None:
            for key, value in configured.items():
                if str(key) == str(experiment):
                    wells = value
                    break
        if wells is None:
            continue
        if isinstance(wells, str):
            return [wells]
        return [str(w) for w in wells]
    return []


def _selected_wells_csv(experiment: str) -> str:
    return ",".join(_configured_wells_for_experiment(experiment))

# ============================================================================
# Plate metadata (optional for build/segment/snips)
# ============================================================================


rule ingest_plate_metadata:
    """
    Normalize and validate plate layout metadata.

    Reads raw plate layout CSV/Excel, normalizes column names, adds
    experiment_id and well_id, then validates against schema.
    """
    input:
        plate_file = PLATE_METADATA_DIR / "{experiment}_well_metadata.xlsx"
    output:
        normalized_csv = PLATE_METADATA_CSV,
        validated = EXPERIMENT_METADATA_DIR / "{experiment}" / ".plate_metadata.validated"
    params:
        experiment_id = "{experiment}"
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks ingest-plate-metadata \
          --input-file "{input.plate_file}" \
          --experiment "{params.experiment_id}" \
          --output-csv "{output.normalized_csv}"
        printf 'ok\n' > "{output.validated}"
        """



rule ingest_scope_metadata:
    """
    Extract scope metadata from the configured microscope's raw image files.

    Reads raw metadata to extract:
    - Micrometers per pixel (calibration)
    - Frame interval (timing)
    - Image dimensions
    - Channel information
    - Series/well mapping
    - Timestamps
    """
    input:
        raw_images_dir = RAW_IMAGES_DIR / MICROSCOPE / "{experiment}"
    output:
        # YX1 emits the maximal acquisition inventory from the one raw read (record-only).
        # Keyence does not yet, so the inventory output is YX1-only.
        **(
            {"scope_csv": SCOPE_METADATA_CSV, "acquisition_inventory_csv": SCOPE_ACQUISITION_INVENTORY_CSV}
            if MICROSCOPE == "YX1"
            else {"scope_csv": SCOPE_METADATA_CSV}
        )
    params:
        experiment_id = "{experiment}",
        acquisition_inventory_arg = (
            lambda wc, output: f'--acquisition-inventory-csv "{output.acquisition_inventory_csv}"'
            if MICROSCOPE == "YX1"
            else ""
        ),
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks ingest-scope-metadata \
          --raw-images-dir "{input.raw_images_dir}" \
          --experiment "{params.experiment_id}" \
          --microscope "{MICROSCOPE}" \
          --output-csv "{output.scope_csv}" \
          {params.acquisition_inventory_arg}
        """


rule map_positions_to_wells:
    """
    Physical positions-to-wells mapping (CSV→CSV) for the configured microscope.

    YX1: reads stage XY from scope_metadata CSV (no second ND2 open).
         Requires scope_metadata.yx1.ref_xy_csv in config.yaml.
    Keyence: near-passthrough (well already resolved at ingest).
    """
    input:
        scope_csv = SCOPE_METADATA_CSV,
    output:
        mapping_csv = POSITION_WELL_MAPPING_CSV,
        provenance_json = POSITION_WELL_MAPPING_PROVENANCE,
    params:
        experiment_id = "{experiment}",
        ref_xy_csv = str(YX1_REF_XY_CSV) if YX1_REF_XY_CSV else "",
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks map-positions-to-wells \
          --experiment "{params.experiment_id}" \
          --microscope "{MICROSCOPE}" \
          --scope-csv "{input.scope_csv}" \
          --ref-xy-csv "{params.ref_xy_csv}" \
          --output-mapping-csv "{output.mapping_csv}" \
          --output-provenance-json "{output.provenance_json}"
        """


rule apply_position_to_well_mapping:
    """
    Apply position-to-well mapping to raw scope metadata to produce canonical well_index/well_id/image_id.
    """
    input:
        scope_csv = SCOPE_METADATA_CSV,
        mapping_csv = POSITION_WELL_MAPPING_CSV,
    output:
        mapped_csv = SCOPE_METADATA_MAPPED_CSV,
        validated = SCOPE_METADATA_MAPPED_VALIDATED,
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks apply-position-to-well-mapping \
          --experiment "{wildcards.experiment}" \
          --scope-csv "{input.scope_csv}" \
          --mapping-csv "{input.mapping_csv}" \
          --output-csv "{output.mapped_csv}"
        printf 'ok\n' > "{output.validated}"
        """

# ============================================================================
# Image building + physical frame manifest
# ============================================================================


rule materialize_stitched_images:
    input:
        raw_images_dir = RAW_IMAGES_DIR / MICROSCOPE / "{experiment}",
        mapping_csv = POSITION_WELL_MAPPING_CSV,
        scope_csv = SCOPE_METADATA_MAPPED_CSV,
    output:
        stitched_index = EXPERIMENT_METADATA_DIR / "{experiment}" / "stitched_image_index.csv",
        done = BUILT_IMAGE_DATA_DIR / "{experiment}" / ".materialize_stitched_images.done"
    params:
        experiment_id = "{experiment}",
        selected_wells = lambda wc: _selected_wells_csv(wc.experiment),
        device = lambda wc: str(config.get("image_building", {}).get("device", "cuda")),
        overwrite = lambda wc: int(bool(config.get("image_building", {}).get("overwrite", False))),
        z_buffer = lambda wc: int(bool(config.get("image_building", {}).get("yx1", {}).get("z_buffer", False))),
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks materialize-stitched \
          --experiment "{params.experiment_id}" \
          --microscope "{MICROSCOPE}" \
          --raw-images-dir "{input.raw_images_dir}" \
          --scope-csv "{input.scope_csv}" \
          --mapping-csv "{input.mapping_csv}" \
          --output-root "{BUILT_IMAGE_DATA_DIR}" \
          --output-stitched-index-csv "{output.stitched_index}" \
          --selected-wells "{params.selected_wells}" \
          --output-image-extension "jpg" \
          --device-preference "{params.device}" \
          --overwrite "{params.overwrite}" \
          --done-flag "{output.done}"
        """


rule build_frame_contract:
    input:
        stitched_index = EXPERIMENT_METADATA_DIR / "{experiment}" / "stitched_image_index.csv",
        mapped_scope = SCOPE_METADATA_MAPPED_CSV,
    output:
        contract = EXPERIMENT_METADATA_DIR / "{experiment}" / "frame_contract.csv",
        validated = EXPERIMENT_METADATA_DIR / "{experiment}" / ".frame_contract.validated",
    params:
        channel_id = lambda wildcards: str(config.get("segmentation_and_tracking", {}).get("channel_id", "BF")),
    shell:
        """
                {RUN} -m data_pipeline.metadata_ingest.frame_contract.build_frame_contract \
                    --stitched-index-csv "{input.stitched_index}" \
                    --scope-metadata-csv "{input.mapped_scope}" \
                    --output-csv "{output.contract}"
                echo "ok" > "{output.validated}"
        """


checkpoint discover_wells:
    input:
        mapped_csv = SCOPE_METADATA_MAPPED_CSV,
        validated = SCOPE_METADATA_MAPPED_VALIDATED,
    output:
        wells = DISCOVERED_WELLS_TXT,
    shell:
        """
        {RUN} -m data_pipeline.pipeline_orchestrator.tasks discover-wells \
          --mapped-csv "{input.mapped_csv}" \
          --output-wells "{output.wells}"
        """

def wells_for_experiment(wildcards):
    checkpoints.discover_wells.get(experiment=wildcards.experiment)
    return run_well_ids_for_experiment(
        wildcards.experiment,
        config,
        output_root=DATA_ROOT,
    )


# ============================================================================
# Segmentation + tracking (per well)
# ============================================================================

rule segment_and_track_per_well:
    input:
        manifest = EXPERIMENT_METADATA_DIR / "{experiment}" / "frame_contract.csv",
        validated = EXPERIMENT_METADATA_DIR / "{experiment}" / ".frame_contract.validated",
    output:
        out_csv = SEGMENTATION_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / "segmentation_tracking.csv",
        done = SEGMENTATION_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / ".segmentation_tracking.validated",
    params:
        device = lambda wc: str(config.get("segmentation_and_tracking", {}).get("device", "cuda")),
        pipeline_cfg = lambda wc: json.dumps(config),
    shell:
        """
        {RUN} -m data_pipeline.segmentation_and_tracking.entrypoints.run_segmentation_and_tracking \
          --frame-manifest "{input.manifest}" \
          --experiment-id "{wildcards.experiment}" \
          --well-id "{wildcards.well_id}" \
          --output-root "{DATA_ROOT}" \
          --device "{params.device}" \
          --pipeline-cfg-json '{params.pipeline_cfg}'
        """


rule merge_segmentation_tracking:
    input:
        lambda wc: [
            str(SEGMENTATION_DIR / wc.experiment / "per_well" / w / "contracts" / "segmentation_tracking.csv")
            for w in wells_for_experiment(wc)
        ]
    output:
        merged = SEGMENTATION_DIR / "{experiment}" / "contracts" / "segmentation_tracking.csv",
    shell:
        """
        {RUN} -m data_pipeline.segmentation_and_tracking.pipelines.merge_segmentation_and_tracking_contracts           --experiment "{wildcards.experiment}"           --output-root "{DATA_ROOT}"
        """


rule validate_segmentation_tracking:
    input:
        merged = SEGMENTATION_DIR / "{experiment}" / "contracts" / "segmentation_tracking.csv",
    output:
        done = SEGMENTATION_DIR / "{experiment}" / "contracts" / ".segmentation_tracking_merged.validated",
    shell:
        """
        {RUN} {PROJECT_ROOT}/src/data_pipeline/segmentation_and_tracking/pipelines/validate_segmentation_and_tracking.py           --input-csv "{input.merged}"           --output-flag "{output.done}"
        """

# ============================================================================
# Snip processing (per well, consumes segmentation_tracking only)
# ============================================================================

rule run_snip_processing_per_well:
    input:
        seg = SEGMENTATION_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / "segmentation_tracking.csv",
        seg_done = SEGMENTATION_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / ".segmentation_tracking.validated",
    output:
        manifest = PROCESSED_SNIPS_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / "snip_manifest.parquet",
        done = PROCESSED_SNIPS_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / ".snip_manifest.validated",
    params:
        out_h = lambda wc: int(config.get("snip_processing", {}).get("output_shape", [576, 256])[0]),
        out_w = lambda wc: int(config.get("snip_processing", {}).get("output_shape", [576, 256])[1]),
        target_um = lambda wc: float(config.get("snip_processing", {}).get("target_pixel_size_um", 7.8)),
        save_raw = lambda wc: int(bool(config.get("snip_processing", {}).get("save_raw_crops", True))),
        write_csv = lambda wc: int(bool(config.get("snip_processing", {}).get("write_manifest_csv", True))),
        bg_n = lambda wc: int(config.get("snip_processing", {}).get("background_n_samples", 100)),
        bg_seed = lambda wc: int(config.get("snip_processing", {}).get("background_seed", 309)),
    shell:
        """
        {RUN} -m data_pipeline.snip_processing.run_from_segmentation_tracking \
          --segmentation-tracking "{input.seg}" \
          --output-root "{DATA_ROOT}" \
          --output-shape {params.out_h} {params.out_w} \
          --target-pixel-size-um {params.target_um} \
          --save-raw-crops {params.save_raw} \
          --write-manifest-csv {params.write_csv} \
          --background-n-samples {params.bg_n} \
          --background-seed {params.bg_seed}
        """


rule merge_snip_manifests:
    input:
        lambda wc: [
            str(PROCESSED_SNIPS_DIR / wc.experiment / "per_well" / w / "contracts" / "snip_manifest.parquet")
            for w in wells_for_experiment(wc)
        ]
    output:
        merged = PROCESSED_SNIPS_DIR / "{experiment}" / "contracts" / "snip_manifest.parquet",
    shell:
        """
        {RUN} -m data_pipeline.snip_processing.pipelines.merge_snip_manifests           --experiment "{wildcards.experiment}"           --output-root "{DATA_ROOT}"           --write-views 1
        """


rule validate_snip_manifest:
    input:
        merged = PROCESSED_SNIPS_DIR / "{experiment}" / "contracts" / "snip_manifest.parquet",
    output:
        done = PROCESSED_SNIPS_DIR / "{experiment}" / "contracts" / ".snip_manifest_merged.validated",
    shell:
        """
        {RUN} {PROJECT_ROOT}/src/data_pipeline/snip_processing/pipelines/validate_snip_manifest.py           --input "{input.merged}"           --output-flag "{output.done}"
        """

# ============================================================================
# Auxiliary masks (per well, aggregated per experiment)
# ============================================================================

rule generate_auxiliary_masks_well:
    input:
        frame_contract = EXPERIMENT_METADATA_DIR / "{experiment}" / "frame_contract.csv",
        frame_contract_done = EXPERIMENT_METADATA_DIR / "{experiment}" / ".frame_contract.validated",
    output:
        manifest = AUXILIARY_MASKS_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / "auxiliary_masks.csv",
        done = AUXILIARY_MASKS_DIR / "{experiment}" / "per_well" / "{well_id}" / "contracts" / ".auxiliary_masks.validated",
    params:
        model_root = lambda wc: str(MODELS_DIR / "segmentation"),
        batch_size = lambda wc: int(config.get("auxiliary_masks", {}).get("batch_size", 64)),
        num_workers = lambda wc: int(config.get("auxiliary_masks", {}).get("num_workers", 1)),
        overwrite_flag = lambda wc: "--overwrite" if bool(config.get("auxiliary_masks", {}).get("overwrite", False)) else "",
    shell:
        """
        {RUN} -m data_pipeline.auxiliary_masks.materialize_auxiliary_masks \
          --frame-contract "{input.frame_contract}" \
          --output-root "{AUXILIARY_MASKS_DIR}/{wildcards.experiment}/per_well/{wildcards.well_id}" \
          --output-manifest-csv "{output.manifest}" \
          --model-root "{params.model_root}" \
          --well-id "{wildcards.well_id}" \
          --batch-size {params.batch_size} \
          --num-workers {params.num_workers} \
          {params.overwrite_flag}
        """

rule aggregate_auxiliary_masks:
    input:
        manifests=lambda wc: [
            AUXILIARY_MASKS_DIR / wc.experiment / "per_well" / well_id / "contracts" / "auxiliary_masks.csv"
            for well_id in wells_for_experiment(wc)
        ],
        well_done=lambda wc: [
            AUXILIARY_MASKS_DIR / wc.experiment / "per_well" / well_id / "contracts" / ".auxiliary_masks.validated"
            for well_id in wells_for_experiment(wc)
        ],
    output:
        manifest = AUXILIARY_MASKS_DIR / "{experiment}" / "contracts" / "auxiliary_masks.csv",
        done = AUXILIARY_MASKS_DIR / "{experiment}" / "contracts" / ".auxiliary_masks.validated",
    shell:
        """
        {RUN} -m data_pipeline.auxiliary_masks.merge_auxiliary_masks \
          --inputs {input.manifests} \
          --output-manifest-csv "{output.manifest}"
        """


