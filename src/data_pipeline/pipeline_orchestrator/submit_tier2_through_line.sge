#!/bin/bash
# SGE submission for Tier 2 (WIDTH) of the data-flow through-line test plan.
#   docs/refactors/streamline-snakemake/target/specs/data_flow_test_plan.md  (Tier 2)
#
# One GPU node; snakemake schedules all 95 wells and all timepoints of 20250912 raw ND2 ->
# snip_qc *inside* this one node (CPU stages parallel via --cores, GPU stages serialize on the
# one card).
#
# Submit from src/data_pipeline/pipeline_orchestrator:
#   qsub submit_tier2_through_line.sge
#
# GPU GATE: launch only after mdcolon verifies the Tier-1 depth result (cleared 2026-06-29).

# Resource flags mirror the lab's proven GPU job (segmentation_sandbox/.../run_pipeline.sh):
# gpgpu=TRUE,cuda=1 + mfree + serial PE. Differences for this overnight width run:
#   - trapnell-long.q (not -login.q): an overnight ~2800-job fan, not an interactive session.
#   - 8-slot serial PE + mfree=12G/slot (~96G): snakemake runs CPU stages 8-way parallel inside
#     this one node; GPU stages serialize on the single requested card.
#$ -N tier2_through_line
#$ -cwd
#$ -q trapnell-long.q
#$ -l gpgpu=TRUE,cuda=1
#$ -l mfree=12G
#$ -pe serial 8
#$ -o tier2_through_line.$JOB_ID.out
#$ -e tier2_through_line.$JOB_ID.err

set -euo pipefail

CONDA_BASE="/net/trapnell/vol1/home/mdcolon/software/miniconda3"
CONDA_ENV="segmentation_grounded_sam"
SRC_ROOT="/net/trapnell/vol1/home/mdcolon/proj/morphseq-docs/src"
CORES=8

echo "=== Tier 2 through_line — $(date) on $(hostname) ==="
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
nvidia-smi -L || echo "WARNING: nvidia-smi -L failed — no GPU visible on this node"

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"

# The Snakefile imports `data_pipeline` at parse time, so src/ must be on PYTHONPATH for the
# calling process (the Snakefile only sets it for the *rule* shells, not for itself).
export PYTHONPATH="${SRC_ROOT}:${PYTHONPATH:-}"

# Snakemake schedules the 95-well full-time-series DAG inside this single node. `--configfile` takes
# multiple values (main + tier-2 overlay). --rerun-triggers mtime avoids re-running expensive ND2
# ingest on provenance triggers; --keep-going lets a single bad well fail without killing the
# whole fan (so the well-accounting table at the end is meaningful). -n is the target.
snakemake \
  --configfile config.yaml config_smoke_through_line_tier2_20250912.yaml \
  --cores "${CORES}" \
  --rerun-triggers mtime \
  --keep-going \
  --printshellcmds \
  through_line

echo "=== Tier 2 through_line FINISHED — $(date) — exit $? ==="
