#!/bin/bash
# SGE submission — 2-well end-to-end TEST of the 20260702 hotchem run (Route A env).
# Wells A01,A02 of 20260702_hotchem_24hpf_plate01, target `all`.
#
# Submit from src/data_pipeline/pipeline_orchestrator:
#   qsub submit_test_2well_20260702.sge
# Watch:   qstat            (your jobs)     |  cancel:  qdel <JOB_ID>
# Logs:    test_2well_20260702.<JOB_ID>.out / .err  (written in this dir, -cwd)

# ---- SGE resource directives (read by qsub) --------------------------------------------------
#$ -N test_2well_hotchem          # job name
#$ -cwd                           # run in the dir you submit from
#$ -q trapnell-long.q             # GPU queue (matches the lab's proven GPU jobs)
#$ -l gpgpu=TRUE,cuda=1           # request 1 GPU
#$ -l mfree=16G                   # memory per slot
#$ -pe serial 4                   # 4 CPU slots on ONE node (snakemake --cores)
#$ -o test_2well_20260702.$JOB_ID.out
#$ -e test_2well_20260702.$JOB_ID.err

set -euo pipefail

# Route A: mdcolon's conda + env; run the snakemake binary directly (no `conda activate`).
CONDA_BASE="/net/trapnell/vol1/home/mdcolon/software/miniconda3"
CONDA_ENV="segmentation_grounded_sam"
SNAKEMAKE="${CONDA_BASE}/envs/${CONDA_ENV}/bin/snakemake"
# NOTE: YOUR repo src (not mdcolon's) — this is what makes it run your code + configs.
SRC_ROOT="/net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/src"
# CORES=1 for the test: serialize so every per-well `validate` runs before its `merge`
# (the merge rules depend on the .csv but not the .validated sentinel — race under --cores>1).
CORES=1

echo "=== test_2well_hotchem START $(date) on $(hostname) ==="
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
nvidia-smi -L || echo "WARNING: nvidia-smi -L failed — no GPU visible on this node"

# Snakefile imports data_pipeline at parse time, so src/ must be on PYTHONPATH for snakemake itself.
export PYTHONPATH="${SRC_ROOT}:${PYTHONPATH:-}"

# Compute nodes are OFFLINE. GroundingDINO's text encoder loads `bert-base-uncased` via
# HuggingFace; force transformers to use the local cache (pre-downloaded into ~/.cache/huggingface
# on an online login node) instead of hanging on a network call.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# Target BEFORE --configfile (--configfile is greedy). No --keep-going: for a TEST we want the
# first failure to surface immediately.
"${SNAKEMAKE}" all \
  --cores "${CORES}" \
  --rerun-triggers mtime \
  --printshellcmds \
  --configfile config.yaml config_test_2well_20260702_24hpf_plate01.yaml

echo "=== test_2well_hotchem FINISHED $(date) — exit $? ==="
