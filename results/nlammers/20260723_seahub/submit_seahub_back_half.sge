#!/bin/bash
# Run the standard pipeline through analysis_ready for one materialized SeaHub shard.

#$ -N seahub_back
#$ -cwd
#$ -q trapnell-long.q
#$ -l gpgpu=TRUE,cuda=1
#$ -l mfree=32G
#$ -pe serial 4
#$ -o /net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/logs/seahub_back.$JOB_ID.$TASK_ID.out
#$ -e /net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/logs/seahub_back.$JOB_ID.$TASK_ID.err

set -euo pipefail

REPO_ROOT="/net/trapnell/vol1/home/nlammers/projects/repositories/morphseq"
SRC_ROOT="${REPO_ROOT}/src"
WORKFLOW_DIR="${SRC_ROOT}/data_pipeline/pipeline_orchestrator"
WORK_DIR="${REPO_ROOT}/results/nlammers/20260723_seahub"
source "${WORK_DIR}/seahub_run_env.sh"
seahub_configure_run \
    "${WORK_DIR}" \
    "/net/trapnell/vol1/home/nlammers/projects/data/morphseq/seahub/derived"
BUNDLE_ROOT="${SEAHUB_BUNDLE_ROOT}"
EXPERIMENTS="${BUNDLE_ROOT}/integration/experiments.txt"
CONDA_BASE="/net/trapnell/vol1/home/mdcolon/software/miniconda3"
CONDA_ENV="segmentation_grounded_sam"
SNAKEMAKE="${CONDA_BASE}/envs/${CONDA_ENV}/bin/snakemake"
PYTHON="${CONDA_BASE}/envs/${CONDA_ENV}/bin/python"
CORES=4
TARGET="analysis_ready"

if [[ -z "${SGE_TASK_ID:-}" || "${SGE_TASK_ID}" == "undefined" ]]; then
    echo "ERROR: submit this script as an SGE array job." >&2
    exit 2
fi
EXPERIMENT_ID="$(sed -n "${SGE_TASK_ID}p" "${EXPERIMENTS}")"
if [[ -z "${EXPERIMENT_ID}" ]]; then
    echo "ERROR: no experiment at task index ${SGE_TASK_ID}." >&2
    exit 2
fi

EXPERIMENT_ROOT="${BUNDLE_ROOT}/experiments/${EXPERIMENT_ID}"
RUNTIME_CONFIG="${EXPERIMENT_ROOT}/runtime_config.yaml"
FRAME_VALIDATED="${EXPERIMENT_ROOT}/dropin_frame_inventory.csv.validated"
PLATE_VALIDATED="${EXPERIMENT_ROOT}/plate_metadata.csv.validated"
for REQUIRED in "${RUNTIME_CONFIG}" "${FRAME_VALIDATED}" "${PLATE_VALIDATED}"; do
    if [[ ! -f "${REQUIRED}" ]]; then
        echo "ERROR: materialized shard input is missing: ${REQUIRED}" >&2
        exit 2
    fi
done

# Reopen and verify every recorded image before handing the shard to GPU work.
"/net/trapnell/vol1/home/nlammers/micromamba/bin/conda" \
    run -n morphseq-env --no-capture-output \
    env PYTHONPATH="${SRC_ROOT}" \
    python -m data_pipeline.acquisition.seahub preflight-shard \
    --bundle-root "${BUNDLE_ROOT}" \
    --experiment-id "${EXPERIMENT_ID}"

OUTPUT_ROOT="$("${PYTHON}" -c \
    "import yaml; print(yaml.safe_load(open('${WORKFLOW_DIR}/env.yaml'))['paths']['output_root'])")"
SMK_WORKDIR="${OUTPUT_ROOT}/work_directories/${EXPERIMENT_ID}"
EXISTING_NAMESPACE="$(
    find "${OUTPUT_ROOT}" -mindepth 2 -maxdepth 2 \
        -name "${EXPERIMENT_ID}" -print -quit 2>/dev/null || true
)"
if [[ -n "${EXISTING_NAMESPACE}" ]]; then
    echo "ERROR: refusing stale or colliding pipeline namespace for ${EXPERIMENT_ID}: ${EXISTING_NAMESPACE}" >&2
    exit 2
fi
mkdir -p "${SMK_WORKDIR}" "${REPO_ROOT}/logs"
cd "${WORKFLOW_DIR}"

if [[ -n "${SGE_HGR_cuda:-}" ]]; then
    GPU_COUNT="$(echo "${SGE_HGR_cuda}" | wc -w)"
    export CUDA_VISIBLE_DEVICES="$(seq -s, 0 $((GPU_COUNT - 1)))"
fi

echo "=== SeaHub standard pipeline START $(date) ==="
echo "host=$(hostname) job=${JOB_ID:-unknown} task=${SGE_TASK_ID}"
echo "experiment=${EXPERIMENT_ID}"
echo "runtime_config=${RUNTIME_CONFIG}"
echo "workdir=${SMK_WORKDIR}"
echo "target=${TARGET}"
echo "SGE_HGR_cuda=${SGE_HGR_cuda:-<unset>}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
nvidia-smi -L

export PYTHONPATH="${SRC_ROOT}:${PYTHONPATH:-}"
LOCK_DIR="${SMK_WORKDIR}/.snakemake/locks"
LOCK_FILE="$(find "${LOCK_DIR}" -mindepth 1 -maxdepth 1 -type f -print -quit 2>/dev/null || true)"
if [[ -n "${LOCK_FILE}" ]]; then
    echo "ERROR: Snakemake lock present for ${EXPERIMENT_ID}: ${LOCK_FILE}" >&2
    exit 2
fi

"${SNAKEMAKE}" \
    --configfile "${WORKFLOW_DIR}/config.yaml" "${RUNTIME_CONFIG}" \
    --directory "${SMK_WORKDIR}" \
    --cores "${CORES}" \
    --resources gpu=1 \
    --latency-wait 300 \
    --rerun-triggers mtime \
    --keep-going \
    --printshellcmds \
    "${TARGET}"

echo "=== SeaHub standard pipeline FINISHED ${EXPERIMENT_ID} $(date) ==="
