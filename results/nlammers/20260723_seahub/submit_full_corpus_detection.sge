#!/bin/bash
# Full-corpus SeaHub GroundingDINO detection, one source experiment per task.
#
# Submit with:
#   qsub -t 1-20 -tc 1 -l gpgpu=TRUE,cuda=1 submit_full_corpus_detection.sge

#$ -N seahub_gdino
#$ -cwd
#$ -q trapnell-long.q
#$ -l mfree=32G
#$ -l h_rt=28800
#$ -pe serial 4
#$ -o /net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/logs/seahub_gdino.$JOB_ID.$TASK_ID.out
#$ -e /net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/logs/seahub_gdino.$JOB_ID.$TASK_ID.err

set -euo pipefail

REPO_ROOT="/net/trapnell/vol1/home/nlammers/projects/repositories/morphseq"
WORK_DIR="${REPO_ROOT}/results/nlammers/20260723_seahub"
RECONCILED="${WORK_DIR}/outputs/full_corpus_20260724/integration/reconciled_fovs.csv"
OUTPUT_ROOT="${WORK_DIR}/outputs/full_corpus_20260724/detection"
CONDA="/net/trapnell/vol1/home/nlammers/micromamba/bin/conda"

if [[ -z "${SGE_TASK_ID:-}" || "${SGE_TASK_ID}" == "undefined" ]]; then
    echo "ERROR: submit this script as an SGE array job." >&2
    exit 2
fi

mkdir -p "${REPO_ROOT}/logs" "${OUTPUT_ROOT}"
cd "${REPO_ROOT}"

if [[ -n "${SGE_HGR_cuda:-}" ]]; then
    GPU_COUNT="$(echo "${SGE_HGR_cuda}" | wc -w)"
    export CUDA_VISIBLE_DEVICES="$(seq -s, 0 $((GPU_COUNT - 1)))"
fi
echo "=== SeaHub detection START $(date) ==="
echo "host=$(hostname) job=${JOB_ID:-unknown} task=${SGE_TASK_ID}"
echo "SGE_HGR_cuda=${SGE_HGR_cuda:-<unset>}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
nvidia-smi -L

export PYTHONDONTWRITEBYTECODE=1
"${CONDA}" run -n morphseq-env --no-capture-output \
    python "${WORK_DIR}/run_full_corpus_detection_task.py" \
    --reconciled-fovs-csv "${RECONCILED}" \
    --output-root "${OUTPUT_ROOT}"

echo "=== SeaHub detection FINISHED task=${SGE_TASK_ID} $(date) ==="
