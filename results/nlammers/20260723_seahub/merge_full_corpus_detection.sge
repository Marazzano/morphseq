#!/bin/bash
# Merge job submitted with:
#   qsub -v SEAHUB_RUN_ID=20260731_prod01 \
#     -hold_jid <SeaHub detection array job id> merge_full_corpus_detection.sge

#$ -N seahub_merge
#$ -cwd
#$ -q trapnell-short.q
#$ -l mfree=8G
#$ -l h_rt=3600
#$ -pe serial 1
#$ -o /net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/logs/seahub_merge.$JOB_ID.out
#$ -e /net/trapnell/vol1/home/nlammers/projects/repositories/morphseq/logs/seahub_merge.$JOB_ID.err

set -euo pipefail

REPO_ROOT="/net/trapnell/vol1/home/nlammers/projects/repositories/morphseq"
WORK_DIR="${REPO_ROOT}/results/nlammers/20260723_seahub"
source "${WORK_DIR}/seahub_run_env.sh"
seahub_configure_run \
    "${WORK_DIR}" \
    "/net/trapnell/vol1/home/nlammers/projects/data/morphseq/seahub/derived"
RECONCILED="${SEAHUB_RUN_ROOT}/integration/reconciled_fovs.csv"
OUTPUT_ROOT="${SEAHUB_RUN_ROOT}/detection"
CONDA="/net/trapnell/vol1/home/nlammers/micromamba/bin/conda"

cd "${REPO_ROOT}"
export PYTHONDONTWRITEBYTECODE=1
"${CONDA}" run -n morphseq-env --no-capture-output \
    python "${WORK_DIR}/merge_full_corpus_detection.py" \
    --reconciled-fovs-csv "${RECONCILED}" \
    --output-root "${OUTPUT_ROOT}"
